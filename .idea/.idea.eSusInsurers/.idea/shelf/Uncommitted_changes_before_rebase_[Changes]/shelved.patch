+
+       private void SetupValidToken(int expiryMinutes = 120)
+       {
+           var token = CreateJwtToken(DateTime.UtcNow.AddMinutes(expiryMinutes));
+           _httpContext.Request.Headers["Authorization"] = $"Bearer {token}";
+       }
+
+       private string CreateJwtToken(DateTime expiryTime)
+       {
+           var token = new JwtSecurityToken(
+               expires: expiryTime,
+               claims: new List<System.Security.Claims.Claim>()
+           );
+           return new JwtSecurityTokenHandler().WriteToken(token);
+       }
 
-public class TokenRefreshMiddleWareTests
-{
